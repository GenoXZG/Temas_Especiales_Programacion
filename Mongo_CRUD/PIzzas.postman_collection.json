              "pm.test(\"Devuelve estado 201\", () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Devuelve la pizza creada\", () => {",
              "    const respuesta = pm.response.json();",
              "    const pizza = respuesta.data.pizza;",
              "    const pizzaId = Number(pm.collectionVariables.get(\"pizzaId\"));",
              "",
              "    pm.expect(pizza.id).to.eql(pizzaId);",
              "    pm.expect(pizza.nombre).to.eql(\"Pizza Postman\");",
              "    pm.expect(pizza.descripcion).to.eql(",
              "        \"Pizza creada durante las pruebas\"",
              "    );",
              "    pm.expect(pizza).to.have.property(\"_id\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
